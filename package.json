{
  "name": "rumi-wawqi-pos",
  "version": "2.1.0",
  "private": true,
  "description": "Offline-first restaurant operations and point-of-sale dashboard",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:domain": "node --test tests/shift-core.test.mjs tests/two-phase.test.mjs tests/cli.test.mjs tests/recovery-cli.test.mjs",
    "test:regression": "node --test tests/regression.test.mjs",
    "check": "node --check lib/shift-core.mjs && node --check cli/rumi-lab.mjs && npm test",
    "serve": "python3 -m http.server 8080 --directory app",
    "audit": "node cli/rumi-lab.mjs audit",
    "recovery:check": "node cli/rumi-lab.mjs recovery-check",
    "recover": "node cli/rumi-lab.mjs recover",
    "scenario": "node cli/rumi-lab.mjs scenario",
    "finalize:simulate": "node cli/rumi-lab.mjs simulate-finalize"
  },
  "engines": {
    "node": ">=20"
  }
}
